{
  "openapi": "3.0.3",
  "info": {
    "title": "Dekorasi Event & Wedding Backend API",
    "description": "REST API untuk Sistem Manajemen dan Booking Dekorasi Acara (Pernikahan, Lamaran, Ulang Tahun, Corporate)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check service status",
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register customer baru",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" },
                  "phone": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Customer berhasil didaftarkan" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user dan dapatkan token Sanctum",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login berhasil dan token dikembalikan" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Daftar kategori dekorasi",
        "responses": {
          "200": { "description": "List of categories" }
        }
      }
    },
    "/packages": {
      "get": {
        "summary": "Daftar paket dekorasi aktif dengan pagination",
        "parameters": [
          { "name": "category_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 12 } }
        ],
        "responses": {
          "200": { "description": "Paginated list of packages" }
        }
      }
    },
    "/packages/{slug}": {
      "get": {
        "summary": "Detail paket dekorasi",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Detail paket dekorasi beserta properti item dan review" }
        }
      }
    },
    "/bookings": {
      "get": {
        "summary": "Daftar booking (Customer melihat miliknya, Admin melihat semua)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of bookings" }
        }
      },
      "post": {
        "summary": "Buat pemesanan dekorasi baru",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["package_id", "event_date", "event_location", "event_address"],
                "properties": {
                  "package_id": { "type": "integer" },
                  "event_date": { "type": "string", "format": "date" },
                  "event_time": { "type": "string" },
                  "event_location": { "type": "string" },
                  "event_address": { "type": "string" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Booking berhasil dibuat" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
